###############################################################################
# Environment Configuration - CAG Estimator                                 ###
###############################################################################
#                                                                           ###
# API Keys:                                                                 ###
#   OPENAI_API_KEY: OpenAI API key for authentication                       ###                
#   ANTHROPIC_API_KEY: Anthropic API key for authentication                 ###
#   GEMINI_API_KEY: Google Gemini API key for authentication                ###
#                                                                           ###
# LLM Configuration:                                                        ###
#   LLM_PROVIDER: Select the LLM provider to use                            ###
#     Options: openai | anthropic | gemini                                  ###
#   LLM_MODEL: Model identifier for the selected provider                   ###
#     Examples: gpt-4o-mini, claude-opus-5, gemini-pro                      ###
#                                                                           ###
# Application Settings:                                                     ###
#   APP_ENV: Environment where the app is running                           ###
#     Options: development | production | staging                           ###
#   LOG_LEVEL: Logging verbosity level                                      ###
#     Options: DEBUG | INFO | WARN | ERROR                                  ###
#                                                                           ###
###############################################################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
APP_ENV=
LOG_LEVEL=
